# ---------------------------------------------------------------- 凭证（等同密码，绝不入库）
# 从浏览器抓到的智慧树登录态
cookies.json
# 本地配置（含 engine_home 等本机路径；样例见 config.example.json）
config.json
*.local.json

# ---------------------------------------------------------------- 运行数据（含课程号 / 题干 / 答案 / 进度）
data/
shots/
logs/
*.logs/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-clean/

# ---------------------------------------------------------------- 构建 / 分发
dist/
build/
# 桌面端构建产物（desktop/build.ps1 输出：ZHStudio.exe 与 _internal/，体积上百 MB，绝不入库）
dist_exe/
# PyInstaller 产物与缓存（spec 文件本身是构建源，必须提交，不要忽略 *.spec）
*.exe
*.manifest

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 其它
*.bak
*.tmp
