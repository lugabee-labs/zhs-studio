{
  "_comment": [
    "复制本文件为 config.json 后再改（config.json 已在 .gitignore 里，不会被提交）。",
    "必填：engine_home —— 指向 fuckZHS 引擎仓库的根目录（能看到 fucker.py 的那一层）。",
    "相对路径一律相对本文件所在的仓库根目录解析；也可以用环境变量覆盖：",
    "ZHS_CONFIG / ZHS_ENGINE_HOME（旧名 FZ_HOME 兼容）/ ZHS_DATA_DIR / ZHS_HOST / ZHS_PORT。",
    "本文件只是样例，不得写入任何真实课程号、cookie、uuid 或本机绝对路径。"
  ],
  "engine_home": "<path-to>/fuckZHS-master",
  "server": {
    "host": "127.0.0.1",
    "port": 8770
  },
  "cdp": {
    "host": "127.0.0.1",
    "port": 9222,
    "timeout_sec": 20,
    "cookie_domain_filter": ["zhihuishu"]
  },
  "cookie_file": "data/cookies.json",
  "data_dir": "data",
  "shots_dir": "shots",
  "bus": {
    "capacity": 3000
  },
  "task": {
    "default_speed": 1.5,
    "retry_delays": [2, 5],
    "sample_interval_sec": 10,
    "sample_interval_pct": 5
  },
  "site": {
    "course_url_template": "https://studyvideoh5.zhihuishu.com/stuStudy?recruitAndCourseId={rac}",
    "home_url": "https://studyvideoh5.zhihuishu.com/"
  },
  "browser": {
    "kind": "edge",
    "path": "",
    "profile_dir": "data/browser-profile",
    "profile_directory": "Default"
  }
}
